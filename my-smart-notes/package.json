{
  "name": "my-smart-notes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "validate": "npm run lint && npm run typecheck",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-hooks.mjs --test --test-concurrency=1 tests/*.test.ts",
    "test:coverage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-hooks.mjs --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=60 --test --test-concurrency=1 tests/*.test.ts",
    "test:ai:live": "node --env-file-if-exists=.env scripts/live-ai-safety-eval.mjs",
    "check": "npm run validate && npm run test:coverage"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@prisma/client": "6.19.3",
    "@sentry/nextjs": "^10.73.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.114.0",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "jspdf": "^4.2.1",
    "next": "15.5.21",
    "pdfjs-dist": "^6.2.108",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "dompurify": "3.4.15",
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "sharp": "0.35.0"
  }
}
