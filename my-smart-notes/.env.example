# PostgreSQL connection string used by the running application.
# On a serverless host, use Supabase's transaction pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=1&sslmode=require"

# Deployment-only secret used by the protected migration workflow.
# This is mapped to DATABASE_URL only for `prisma migrate deploy`.
# Use Supabase's direct/session connection rather than the transaction pooler.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# Supabase project configuration exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-only Supabase key used solely for self-service Auth user deletion.
# Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Server-only OpenAI configuration.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Optional model overrides.
OPENAI_RESPONSE_MODEL="gpt-5.6-terra"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_MODERATION_MODEL="omni-moderation-latest"
